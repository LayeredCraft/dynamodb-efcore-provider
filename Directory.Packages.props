<Project>
  <PropertyGroup>
    <!-- Enable central package management, https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AutoFixture.AutoNSubstitute" Version="4.18.1" />
    <PackageVersion Include="AutoFixture.Xunit3" Version="4.19.0" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="AWSSDK.DynamoDBv2" Version="4.0.103.5" />
    <PackageVersion Include="Humanizer.Core" Version="3.0.10" />
    <PackageVersion Include="LayeredCraft.DynamoMapper" Version="1.6.6" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tasks"
                    Version="[11.0.0-rc.1.26425.128, 12.0.0-a)"
                    Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tasks" Version="10.0.12"
                    Condition="'$(TargetFramework)' != 'net11.0'" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.400" />
    <!-- Testing Libraries -->
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="JetBrains.Annotations" Version="2026.2.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
    <PackageVersion Include="Testcontainers.DynamoDb" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.XunitV3" Version="4.14.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.2.0" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="3.2.2" />
    <PackageVersion Include="YTest.MTP.XUnit2" Version="1.0.3" />
  </ItemGroup>
  <PropertyGroup Label="EF Core version selection">
    <EFCoreVersion Condition="'$(TargetFramework)' == 'net11.0'">
      [11.0.0-rc.1.26425.128, 12.0.0-a)
    </EFCoreVersion>
    <EFCoreVersion Condition="'$(EFCoreVersion)' == ''">[10.0.12, 11.0.0)</EFCoreVersion>
  </PropertyGroup>
  <ItemGroup Label="Microsoft EF Core">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(EFCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(EFCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(EFCoreVersion)" />
    <!--
      Exempted from $(EFCoreVersion): every EF11 Specification.Tests build from
      preview.6.26359.118 through the current rc.1.26425.128 depends on
      Microsoft.DotNet.XUnitV3Extensions (an EF-internal CI package not published to
      nuget.org), which breaks restore. preview.5.26302.115 is the newest EF11 build of
      this package whose nuspec does not reference it. Re-pin to $(EFCoreVersion) once a
      newer EF11 build fixes this upstream.
    -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Specification.Tests"
                    Version="$(EFCoreVersion)"
                    Condition="'$(TargetFramework)' != 'net11.0'" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Specification.Tests"
                    Version="11.0.0-preview.5.26302.115"
                    Condition="'$(TargetFramework)' == 'net11.0'" />
  </ItemGroup>
  <ItemGroup Label="Microsoft Extensions net10" Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore"
                    Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="[10.0.12, 11.0.0)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions"
                    Version="[10.0.12, 11.0.0)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="[10.0.12, 11.0.0)" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="[10.0.12, 11.0.0)" />
    <PackageVersion Include="Microsoft.Extensions.Primitives" Version="[10.0.12, 11.0.0)" />
  </ItemGroup>
  <ItemGroup Label="Microsoft Extensions net11" Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore"
                    Version="[11.0.0-rc.1.26425.128, 12.0.0-a)" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions"
                    Version="[11.0.0-rc.1.26425.128, 12.0.0-a)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions"
                    Version="[11.0.0-rc.1.26425.128, 12.0.0-a)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions"
                    Version="[11.0.0-rc.1.26425.128, 12.0.0-a)" />
    <PackageVersion Include="Microsoft.Extensions.Options"
                    Version="[11.0.0-rc.1.26425.128, 12.0.0-a)" />
    <PackageVersion Include="Microsoft.Extensions.Primitives"
                    Version="[11.0.0-rc.1.26425.128, 12.0.0-a)" />
  </ItemGroup>
</Project>